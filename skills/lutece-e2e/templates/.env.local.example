# Copier en .env.local et remplir. NON versionné (voir .gitignore).

# URL du site Lutèce cible (context-root inclus, slash final). Obligatoire.
# Exemple : http://localhost:9090/mon-site/
BASE_URL=

# Identifiants Back Office.
ADMIN_USER=
# Exemple : adminadmin
ADMIN_PASS=

# Base de données Lutèce du site cible (assertion d'effet en base + nettoyage).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Plugin cible : priorise ses fonctionnalités dans le manifeste BO. Vide = site entier.
PLUGIN_NAME=

# Descripteur du plugin cible : contrôle des droits du compte de test. Optionnel.
# Exemple : /chemin/plugin-monplugin/webapp/WEB-INF/plugins/monplugin.xml
PLUGIN_XML=

# Handler d'upload asynchrone du plugin cible : fixe la famille « site ». Optionnel.
# Exemple : monPluginAsynchronousUploadHandler
UPLOAD_HANDLER=

# Chemin du site déployé : contrôle d'espace dans le chemin. Optionnel.
# Exemple : /home/moi/sites/mon-site
SITE_DIR=

# Durée de validité des manifestes de découverte, en heures.
MANIFEST_TTL_H=24

# Utilisateur Front Office de test (spec fo-login). Vide = spec sautée « environnement absent ».
# Créer l'utilisateur via le BO (cf. scripts/testenv/seed-fo-user.md).
FO_USER=
FO_PASS=

# API MailHog de l'environnement de test (specs mail). Défaut : http://localhost:8025
MAILHOG_URL=

# Options d'exécution.
# HEADLESS=1     # 1 = sans interface (CI) ; vide = navigateur visible (démo/debug)
# SLOWMO=350     # ralenti en ms ; 0 par défaut en headless
# FORCE_SETUP=1  # force la reconnexion et la redécouverte FO/BO
